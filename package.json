{
  "name": "identity-service-react-bridge",
  "private": true,
  "version": "1.0.7",
  "description": "Librería de autenticación y autorización con identity service para React",
  "type": "module",
  "main": "./dist/identity-service-client-lib.cjs.js",
  "module": "./dist/identity-service-client-lib.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/identity-service-client-lib.es.js",
      "require": "./dist/identity-service-client-lib.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/identity-service-react-bridge.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": ">=1 <2",
    "jwt-decode": "^4.0.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependencies": {
    "axios": ">=1 <2",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": {
    "email": "gaordonez@gmail.com",
    "name": "German Ordoñez",
    "url": "https://github.com/gaordonezh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaordonezh/identity-service-react-bridge.git"
  }
}
